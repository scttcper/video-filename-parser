{
  "name": "@ctrl/video-filename-parser",
  "version": "0.0.0-placeholder",
  "description": "A radarr style release name parser",
  "keywords": [
    "radarr",
    "release",
    "scene",
    "sonarr"
  ],
  "homepage": "https://video-filename-parser.ep.workers.dev",
  "license": "MIT",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "repository": "scttcper/video-filename-parser",
  "workspaces": [
    "demo"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "demo:build": "pnpm run -r build",
    "demo:watch": "pnpm run -r dev",
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . --fix && oxfmt",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "bench": "vitest bench ./test/bench.bench.ts"
  },
  "devDependencies": {
    "@ctrl/oxlint-config": "1.5.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
