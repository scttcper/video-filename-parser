{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // An app, not a library: nothing emits declarations
    "declaration": false,
    "isolatedDeclarations": false,
    "noEmit": true
  },
  "include": ["src", "../src"]
}
